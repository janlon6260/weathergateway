# Kun lokal serverutvikling. Ingen standardbruker eller AD-omgåelse.
WG_ENVIRONMENT=development
WG_ROLE=control
WG_DATA_ROOT=runtime/development
WG_BIND=127.0.0.1
PORT=8080
WG_ALLOW_LOCAL_HTTP=true
# Sentralt innstillingslager. Utvikling og produksjon bruker ulike databaser.
WG_CONFIG_DB_HOST=172.29.50.40
WG_CONFIG_DB_PORT=3306
WG_CONFIG_DB_DATABASE=weathergateway_development
WG_CONFIG_DB_USER=weathergateway
WG_CONFIG_DB_PASSWORD=''
WG_CONFIG_DB_TLS=false
# Valgfritt, bare ved TLS mot innstillingsdatabasens private CA:
# WG_CONFIG_DB_CA_FILE=runtime/secrets/db-ca.pem
WG_ADMIN_ORIGIN=http://localhost:5173
WG_PUBLIC_ORIGIN=https://wg-api-dev.skrg.no
WG_DEVELOPMENT_ORIGIN=http://localhost:5173
WG_PRODUCTION_ORIGIN=https://weathergateway.skrg.no
WG_ADMIN_CIDRS=127.0.0.0/8,::1/128
WG_TRUSTED_PROXIES=
WG_LDAP_URLS=ldaps://dc01.example.local:636/
WG_LDAP_BASE_DN=DC=example,DC=local
WG_LDAP_BIND_DN=CN=WeatherGateway,OU=Service Accounts,DC=example,DC=local
WG_LDAP_GROUPS='[{"dn":"CN=WeatherGateway-Admins,OU=Groups,DC=example,DC=local","role":"administrator"},{"dn":"CN=WeatherGateway-Operators,OU=Groups,DC=example,DC=local","role":"operator"},{"dn":"CN=WeatherGateway-Readers,OU=Groups,DC=example,DC=local","role":"viewer"}]'
# Passordet kan skrives direkte her. Sitattegn bevarer blant annet # og mellomrom.
WG_LDAP_PASSWORD=''
# Alternativ: passordfil. En ikke-tom WG_LDAP_PASSWORD har prioritet.
# WG_LDAP_PASSWORD_FILE=runtime/secrets/ldap-password
WG_LDAP_CA_FILE=runtime/secrets/ad-ca.pem

# Værdatabaser: fyll inn passord her, og konfigurer hver stasjon i adminpanelet.
# Utvikling godtar bare isolerte databaser med prefikset wg_dev_.
WG_DB_ALLOWED_DATABASES=
# Eksakte vert:port-mål for direkte SQL på privat lokalnett (uten krav om TLS/VPN).
WG_DB_LAN_ENDPOINTS=
WG_DB_PASSWORD=''
WG_DB_CA_FILE=
# Valgfritt: ellers brukes WG_DATA_ROOT/system/certificates. Opprettes uten sertifikater.
WG_CERTIFICATE_ROOT=runtime/secrets/development
# Ekstra IP-/DNS-identiteter som forhåndsutfylles ved utstedelse i panelet:
WG_MQTT_SERVER_NAMES=
WG_DB_CERT_FILE=
WG_DB_KEY_FILE=
# Egne kontoer per stasjon kan bruke WG_DB_PASSWORD_SKODJE osv.
