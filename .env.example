# Kun lokal serverutvikling. Ingen standardbruker eller AD-omgåelse.
WG_ENVIRONMENT=development
WG_ROLE=control
WG_DATA_ROOT=runtime/development
WG_BIND=127.0.0.1
PORT=8080
WG_ALLOW_LOCAL_HTTP=true
WG_ADMIN_ORIGIN=http://localhost:5173
WG_PUBLIC_ORIGIN=https://wg-api-dev.skrg.no
WG_DEVELOPMENT_ORIGIN=http://localhost:5173
WG_PRODUCTION_ORIGIN=https://weathergateway.skrg.no
WG_ADMIN_CIDRS=127.0.0.0/8,::1/128
WG_TRUSTED_PROXIES=
WG_LDAP_URLS=ldaps://dc01.example.local:636/
WG_LDAP_BASE_DN=DC=example,DC=local
WG_LDAP_BIND_DN=CN=WeatherGateway,OU=Service Accounts,DC=example,DC=local
WG_LDAP_GROUPS='[{"dn":"CN=WeatherGateway-Admins,OU=Groups,DC=example,DC=local","role":"administrator"},{"dn":"CN=WeatherGateway-Operators,OU=Groups,DC=example,DC=local","role":"operator"},{"dn":"CN=WeatherGateway-Readers,OU=Groups,DC=example,DC=local","role":"viewer"}]'
# Passordet kan skrives direkte her. Sitattegn bevarer blant annet # og mellomrom.
WG_LDAP_PASSWORD=''
# Alternativ: passordfil. En ikke-tom WG_LDAP_PASSWORD har prioritet.
# WG_LDAP_PASSWORD_FILE=runtime/secrets/ldap-password
WG_LDAP_CA_FILE=runtime/secrets/ad-ca.pem
